{
  "name": "golf-escape-ai",
  "private": true,
  "version": "0.1.0",
  "description": "GOLF ESCAPE AI 第1段階（静止画解析の試作版）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsx --test src/model/*.test.ts",
    "build:esbuild": "node scripts/build.mjs",
    "build:single": "node scripts/build.mjs --single",
    "build:pages": "node scripts/build.mjs --pages",
    "serve:dist": "node scripts/serve.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
